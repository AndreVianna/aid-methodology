---
// A plain HTML form, one per Contact Us page. It works without JavaScript: a GET submit
// sends the typed text to GitHub's new-issue page (or to the reader's email app).
// Nothing is sent until the reader submits there.
interface Props {
  kind: 'site' | 'bug' | 'feedback' | 'contact';
}
const { kind } = Astro.props;

const GITHUB = 'https://github.com/AndreVianna/aid-methodology/issues/new';
const GITHUB_NOTE =
  'Continue on GitHub opens a new issue with your text filled in; nothing is sent until you submit it there, with a free GitHub account.';

type Field = { name: string; label: string; start: string; rows?: number; required?: boolean };
type Form = { action: string; note: string; hidden: [string, string]; fields: Field[]; submit: string };

const FORMS: Record<Props['kind'], Form> = {
  site: {
    action: GITHUB,
    note: GITHUB_NOTE,
    hidden: ['labels', 'site issue'],
    fields: [
      { name: 'title', label: 'Title', start: '[Site] ', required: true },
      { name: 'body', label: 'What is the problem?', start: '**Page:** \n\n**Problem:** ', rows: 8, required: true },
    ],
    submit: 'Continue on GitHub',
  },
  bug: {
    action: GITHUB,
    note: GITHUB_NOTE,
    hidden: ['labels', 'bug'],
    fields: [
      { name: 'title', label: 'Title', start: '[Bug] ' },
      {
        name: 'body',
        label: 'Details',
        start: '**What happened:**\n\n**What I expected:**\n\n**AID version and environment:**\n',
        rows: 10,
      },
    ],
    submit: 'Continue on GitHub',
  },
  feedback: {
    action: GITHUB,
    note: GITHUB_NOTE,
    hidden: ['labels', 'feedback'],
    fields: [
      { name: 'title', label: 'Title', start: '[Feedback] ' },
      { name: 'body', label: 'Your question, feedback or suggestion', start: '', rows: 8, required: true },
    ],
    submit: 'Continue on GitHub',
  },
  contact: {
    action: 'mailto:andre.vianna.rj@hotmail.com',
    note: 'Open your email app starts an email to the maintainer with your text filled in; nothing is sent until you send it.',
    hidden: ['subject', 'AID: request for a conversation'],
    fields: [{ name: 'body', label: 'What would you like to talk about?', start: '', rows: 8, required: true }],
    submit: 'Open your email app',
  },
};

const form = FORMS[kind];
---

<form class="rf" method="get" action={form.action}>
  <p class="rf-note">{form.note}</p>
  <input type="hidden" name={form.hidden[0]} value={form.hidden[1]} />
  {form.fields.map((f) => (
    <>
      <label class="rf-label" for={`rf-${f.name}`}>{f.label}</label>
      {f.rows ? (
        <textarea class="rf-input" id={`rf-${f.name}`} name={f.name} rows={f.rows} required={f.required}>{f.start}</textarea>
      ) : (
        <input class="rf-input" id={`rf-${f.name}`} name={f.name} type="text" value={f.start} required={f.required} />
      )}
    </>
  ))}
  <button class="rf-button" type="submit">{form.submit}</button>
</form>

<style>
  .rf {
    margin: var(--aid-space-5) 0 0;
    padding: var(--aid-space-5);
    border: 1px solid var(--aid-color-border);
    border-radius: var(--aid-radius-lg);
    background: var(--aid-color-nav);
  }
  .rf-note {
    margin: 0 0 var(--aid-space-4);
    font-size: var(--aid-text-sm);
    color: var(--aid-color-text-muted);
  }
  .rf-label {
    display: block;
    margin: var(--aid-space-4) 0 var(--aid-space-1);
    font-size: var(--aid-text-sm);
    font-weight: 600;
    color: var(--aid-color-text-strong);
  }
  .rf-input {
    box-sizing: border-box;
    width: 100%;
    padding: var(--aid-space-2) var(--aid-space-3);
    border: 1px solid var(--aid-color-border-strong);
    border-radius: var(--aid-radius-md);
    background: var(--aid-color-bg);
    color: var(--aid-color-text-strong);
    font: inherit;
    font-size: var(--aid-text-base);
  }
  textarea.rf-input { resize: vertical; }
  .rf-input:focus-visible,
  .rf-button:focus-visible {
    outline: var(--aid-focus-width) solid var(--aid-color-focus);
    outline-offset: var(--aid-focus-offset);
  }
  .rf-input:user-invalid { border-color: var(--aid-color-danger); }
  .rf-button {
    margin-top: var(--aid-space-5);
    padding: var(--aid-space-2) var(--aid-space-4);
    border: 1px solid var(--aid-color-accent);
    border-radius: var(--aid-radius-md);
    background: var(--aid-color-accent);
    color: var(--aid-color-on-accent);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .rf-button:hover { background: var(--aid-color-accent-strong); }
</style>
