---
// Starlight's footer (edit link, previous/next) plus a plain "report a problem" link and the
// version. No script: the link opens GitHub's prefilled issue form.
import Default from '@astrojs/starlight/components/Footer.astro';
import site from '~/generated/site.json';

const { entry, id } = Astro.locals.starlightRoute;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const report =
  `${site.repo}/issues/new?template=feedback.yml` +
  `&title=${encodeURIComponent(`[Docs] ${entry.data.title}`)}&page=${encodeURIComponent(pageUrl)}`;
---

<Default {...Astro.props}><slot /></Default>
<div class="aid-footer">
  <p>
    <a href={report}>Report a problem with this page</a>
    <span aria-hidden="true">·</span>
    <a href="/releases/">AID v{site.version}</a>
  </p>
  <p>
    Made by <a href="https://casuloailabs.com">Casulo AI Labs</a>. Open source under the
    <a href={`${site.repo}/blob/master/LICENSE`}>MIT license</a>.
  </p>
</div>
