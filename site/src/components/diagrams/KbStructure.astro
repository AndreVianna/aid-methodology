---
/** D4: what the Knowledge Base holds and who writes each part. */
import Diagram from '../Diagram.astro';
const id = 'kb-structure';
const arrow = `url(#dg-${id}-arrow)`;
---
<Diagram id={id} width={400} height={440}
  title="What the Knowledge Base holds"
  desc="The Knowledge Base is the folder .aid/knowledge/. It holds a project card, the documents chosen at discovery, and three meta-documents that index and track them. The generated file inventory lives outside it, in .aid/generated/."
  caption="The parts of the Knowledge Base and who writes each one.">
  <rect class="dg-node dg-accent" x="16" y="16" width="160" height="40" rx="6" />
  <text class="dg-label" x="96" y="42" text-anchor="middle">.aid/knowledge/</text>
  <line class="dg-edge" x1="32" y1="56" x2="32" y2="304" />

  <path class="dg-edge" d="M32 112 H48" marker-end={arrow} />
  <rect class="dg-node" x="48" y="88" width="168" height="48" rx="6" />
  <text class="dg-label" x="132" y="108" text-anchor="middle">Project card</text>
  <text class="dg-note" x="132" y="126" text-anchor="middle">PROJECT.md</text>

  <path class="dg-edge" d="M32 176 H48" marker-end={arrow} />
  <rect class="dg-node" x="48" y="152" width="168" height="48" rx="6" />
  <text class="dg-label" x="132" y="172" text-anchor="middle">Documents</text>
  <text class="dg-note" x="132" y="190" text-anchor="middle">one file per topic</text>

  <path class="dg-edge" d="M32 240 H48" marker-end={arrow} />
  <rect class="dg-node" x="48" y="216" width="168" height="48" rx="6" />
  <text class="dg-label" x="132" y="236" text-anchor="middle">Meta-documents</text>
  <text class="dg-note" x="132" y="254" text-anchor="middle">INDEX, README, STATE</text>

  <path class="dg-edge" d="M32 304 H48" marker-end={arrow} />
  <rect class="dg-node dg-optional" x="48" y="280" width="168" height="48" rx="6" />
  <text class="dg-label" x="132" y="300" text-anchor="middle">Extensions</text>
  <text class="dg-note" x="132" y="318" text-anchor="middle">(optional)</text>

  <rect class="dg-node" x="16" y="368" width="200" height="48" rx="6" />
  <text class="dg-label" x="116" y="388" text-anchor="middle">File inventory</text>
  <text class="dg-note" x="116" y="406" text-anchor="middle">in .aid/generated/</text>

  <rect class="dg-node dg-accent" x="272" y="176" width="112" height="240" rx="6" />
  <text class="dg-label" x="328" y="300" text-anchor="middle">/aid-discover</text>
  <path class="dg-edge dg-optional" d="M272 184 H216" marker-end={arrow} />
  <path class="dg-edge dg-optional" d="M272 240 H216" marker-end={arrow} />
  <path class="dg-edge dg-optional" d="M272 392 H216" marker-end={arrow} />
  <rect class="dg-label-bg" x="226" y="206" width="48" height="18" />
  <text class="dg-note" x="244" y="220" text-anchor="middle">writes</text>

  <table slot="text">
    <thead>
      <tr><th scope="col">Part</th><th scope="col">Files</th><th scope="col">Written by</th></tr>
    </thead>
    <tbody>
      <tr><th scope="row">Project card</th><td><code>PROJECT.md</code>, optional, read first in every session</td><td>you, from the project card template</td></tr>
      <tr><th scope="row">Documents</th><td>one file per topic, such as <code>architecture.md</code>, <code>coding-standards.md</code> and <code>test-landscape.md</code>; the full list is on <a href="/reference/kb/">the Knowledge Base documents page</a></td><td><code>/aid-discover</code>, from the standard templates</td></tr>
      <tr><th scope="row">Meta-documents</th><td><code>INDEX.md</code> (one line per document), <code>README.md</code> (completeness), <code>STATE.md</code> (grade and open questions)</td><td><code>/aid-discover</code>; every phase adds its questions to <code>STATE.md</code></td></tr>
      <tr><th scope="row">File inventory</th><td><code>project-index.md</code>, kept in <code>.aid/generated/</code>, outside the knowledge folder</td><td><code>/aid-discover</code>, before its writers start</td></tr>
      <tr><th scope="row">Extensions (optional)</th><td>documents only your project needs</td><td>added to the document set when you confirm it at discovery</td></tr>
    </tbody>
  </table>
</Diagram>
