{
  "outputStyle": "Short",
  "worktree": {
    "bgIsolation": "none"
  },
  "permissions": {
    "allow": [
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(python *)",
      "Bash(rm *)",
      "Bash(./install.sh *)",
      "Bash(grep *)",
      "Bash(chmod *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.aid/runtime/scripts/hooks/aid-question-form.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}